# PRIVA environment — copy to .env and fill in your keys (never commit .env)
LINQ_API_KEY=
LINQ_SANDBOX_NUMBER=
LINQ_WEBHOOK_SECRET=
# iMessage address for PROACTIVE texts (note offers, reminders, price alerts)
# fallback: last person who texted the sandbox number
LINQ_USER_ADDRESS=
PRAVA_SECRET_KEY=sk_test_xxx
PRAVA_PUBLISHABLE_KEY=pk_test_xxx
SERPAPI_KEY=
# optional LLM endpoint for enhanced note analysis (blank = rule-based only)
# OpenAI-compatible; e.g. https://integrate.api.nvidia.com/v1
NOTE_LLM=
# optional model served by NOTE_LLM/OPENAI_API_KEY (blank = auto)
LLM_MODEL=
# OpenAI key for LLM-enhanced note analysis + offers (gpt-4o-mini, ~$0.005/note)
# NOTE_LLM may stay blank — OPENAI_API_KEY auto-selects https://api.openai.com
OPENAI_API_KEY=
# 1 = choreographed demo mode (staged beats, hotkey pacing)
DEMO_MODE=0
# 1 = auto-complete payments ~5s after session creation (judge demo, no card needed)
# 0 = real Prava sandbox: user must complete the payment to finalize the order
SIMULATE_PAYMENT=0
